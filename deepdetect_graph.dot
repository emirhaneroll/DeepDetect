digraph DeepDetect {
    rankdir=LR;
    bgcolor="white";

    node [
        shape=box,
        style="rounded,filled",
        color="#2563eb",
        fillcolor="#eef4ff",
        fontname="Arial",
        fontsize=11
    ];

    edge [
        color="#374151",
        fontname="Arial",
        fontsize=10
    ];

    User [label="Kullanıcı"];
    Upload [label="Görüntü Yükleme"];
    Preprocess [label="Ön İşleme\nBoyutlandırma / Gri Tonlama"];

    ORB [label="ORB Analizi"];
    AKAZE [label="AKAZE Analizi"];
    SIFT [label="SIFT Analizi"];
    SURF [label="SURF Analizi"];

    Suspicious [label="Şüpheli Bölge Analizi"];
    CNN [label="CNN Modeli"];
    LSTM [label="LSTM Modeli"];

    Score [label="Nihai Risk Skoru"];
    Result [label="Sonuç\nGerçek / Şüpheli / Sahte"];

    User -> Upload;
    Upload -> Preprocess;

    Preprocess -> ORB;
    Preprocess -> AKAZE;
    Preprocess -> SIFT;
    Preprocess -> SURF;
    Preprocess -> Suspicious;
    Preprocess -> CNN;
    Preprocess -> LSTM;

    ORB -> Score;
    AKAZE -> Score;
    SIFT -> Score;
    SURF -> Score;
    Suspicious -> Score;
    CNN -> Score;
    LSTM -> Score;

    Score -> Result;
}